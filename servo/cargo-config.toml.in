# Cargo configuration for building servo_capi from the vendored crate
# tarball inside the SDK target (rpm/libservo.spec --with from_source).

[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"

[net]
offline = true

[build]
jobs = 4

[profile.release]
debug = 1
codegen-units = 16
lto = "thin"
